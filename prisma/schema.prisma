datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN // Full access (CA/Owner)
  SERVICE_MANAGER // Manager level
  SENIOR_MECHANIC // Mechanic level
  AUDITOR // Read-only financial access
}

enum DocumentType {
  JOB_CARD
  ESTIMATE
  SOW_BILL
}

enum DocumentStatus {
  DRAFT
  UNDER_INSPECTION
  ESTIMATE_CREATED
  WORK_APPROVED
  IN_SERVICING
  QUALITY_CHECK
  READY_FOR_BILLING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
}

enum TransactionType {
  CREDIT
  DEBIT
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  RECONCILED // For financial auditing
}

model User {
  id             String    @id @default(uuid())
  name           String
  phone          String    @unique
  pinHash        String
  role           Role      @default(SENIOR_MECHANIC)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete for security

  auditLogs AuditLog[] // Actions performed by this user
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  email     String?
  vatNumber String?
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([phone])
}

model Vehicle {
  id         String     @id @default(uuid())
  regNumber  String     @unique // e.g. GJ 01 VP 8363
  makeModel  String // e.g. Honda Activa 6G, RE Electra 350
  runningKm  Int        @default(0)
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  documents  Document[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime? // Soft delete

  @@index([regNumber])
}

model Document {
  id            String         @id @default(uuid())
  docNumber     String         @unique // e.g. MF2-8363, MF2-EST-0908
  type          DocumentType
  status        DocumentStatus @default(DRAFT)
  date          DateTime       @default(now())
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  complaints    String? // Diagnostic and complaint log
  aiDiagnosis   Json? // Cached predictive AI output
  workTypeNote  String?
  paymentMethod PaymentMethod?
  subtotal      Decimal        @db.Decimal(10, 2)
  mdrSurcharge  Decimal        @default(0.00) @db.Decimal(10, 2)
  finalTotal    Decimal        @db.Decimal(10, 2)
  isLocked      Boolean        @default(false)
  pdfUrl        String? // Supabase Storage URL
  createdById   String

  // Security / Anti-Tamper
  integrityHash String? // SHA-256 hash of document contents when locked

  items     LineItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([docNumber])
}

model LineItem {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  sectionName String? // e.g. "CVT Transmission Overhaul", "Labor & Machining"
  title       String
  description String?
  quantity    Decimal  @default(1.00) @db.Decimal(6, 2)
  qtyUnit     String?  @default("Pcs") // "L", "Set", "Pcs"
  rate        Decimal  @db.Decimal(10, 2)
  mrpDiscount Decimal? @default(0.00) @db.Decimal(5, 2) // e.g. 10.00 (%)
  amount      Decimal  @db.Decimal(10, 2)
}

// Immutable Financial Ledger (Append Only)
model Transaction {
  id            String            @id @default(uuid())
  reference     String            @unique // TRX-0992
  type          TransactionType
  date          DateTime          @default(now())
  accountVendor String // Vendor name, Client name, or Account Name
  amount        Decimal           @db.Decimal(12, 2)
  balanceAfter  Decimal?          @db.Decimal(12, 2) // For double-entry ledger verification
  status        TransactionStatus @default(PENDING)
  category      String? // E.g., 'Utilities', 'Parts' for expenses
  notes         String?

  createdById String // User who logged it

  // Security
  integrityHash String? // Chain-linked hash for immutable verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // NO DELETED_AT - Transactions can never be deleted, only cancelled/reversed via a new transaction.

  @@index([reference])
  @@index([type, date])
}

// Highly Secure Immutable Audit Log
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // E.g. "DOCUMENT_LOCKED", "USER_LOGIN_FAILED"
  entityType String // E.g. "Document", "User"
  entityId   String?
  details    Json // Before/After state
  ipAddress  String? // Network tracing
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, action])
  @@index([entityType, entityId])
}

model CompanySettings {
  id            String  @id @default(uuid())
  companyName   String  @default("MotoFit")
  idNumber      String?
  vatNumber     String?
  website       String?
  email         String?
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  postalCode    String?
  logoUrl       String?
  currencyCode  String  @default("INR")

  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ApiClient {
  id        String    @id @default(uuid())
  name      String // "MotoFit Website" or "MotoFit Customer App"
  apiKey    String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}
